{{- $index := slice -}}
{{- $allPages := (index (hugo.Sites) 0).Pages -}}
{{- $currentLang := .Site.Language.Lang -}}
{{- range $allPages -}}
  {{- $include := false -}}
  {{- if eq $currentLang "zh" -}}
    {{- $include = not (in .RelPermalink "/en/") -}}
  {{- else if eq $currentLang "en" -}}
    {{- $include = in .RelPermalink "/en/" -}}
  {{- end -}}
  {{- if and $include (not .Params.excludeFromSearch) -}}
    {{- $section := .Site.GetPage "section" .Section -}}
    {{- if .Date -}}
      {{- $index = $index | append (dict
      "date" (.Date | time.Format (.Site.Language.Params.dateFormat | default ":date_long"))
      "title" (.Title | emojify | safeJS)
      "section" ($section.Title | emojify | safeJS)
      "summary" (.Summary | plainify | htmlUnescape | safeJS)
      "content" (.Plain | safeJS)
      "permalink" .RelPermalink
      "externalUrl" .Params.externalUrl
      "type" .Type
      "language" .Site.Language.Lang
      ) -}}
    {{- else -}}
      {{- $index = $index | append (dict
      "title" (.Title | emojify | safeJS)
      "section" ($section.Title | emojify | safeJS)
      "summary" (.Summary | plainify | htmlUnescape | safeJS)
      "content" (.Plain | safeJS)
      "permalink" .RelPermalink
      "externalUrl" .Params.externalUrl
      "type" .Type
      "language" .Site.Language.Lang
      ) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
