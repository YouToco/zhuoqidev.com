---
import type { GlyphName } from "../data/glyphs";
import type { Lang } from "../i18n";
import { splitTitle, ymd } from "../lib/content";
import PostSticker from "./PostSticker.astro";

interface Props {
  lang: Lang;
  title: string;
  crumb: string;
  date?: Date | undefined;
  searchable?: boolean | undefined;
  glyph?: GlyphName | undefined;
}
const { title, crumb, date, searchable, glyph } = Astro.props;
const { main, sub } = splitTitle(title);
---

<main class="page-wrap">
  <slot name="hero" />
  <article class="paper card" id="main" data-pagefind-body={searchable ? "" : undefined}>
    <div class="crumb" data-pagefind-ignore>
      {crumb}
    </div>
    {glyph && <PostSticker name={glyph} />}
    {date && (
      <div class="meta-row">
        <span class="m">
          <time datetime={ymd(date)}>{ymd(date)}</time>
        </span>
      </div>
    )}
    <h1 class="post-title" data-vt>
      {main}
      {sub && (
        <>
          <span class="sr-only"> — </span>
          <span class="post-sub">{sub}</span>
        </>
      )}
    </h1>
    <div class="prose">
      <slot />
    </div>
  </article>
</main>
