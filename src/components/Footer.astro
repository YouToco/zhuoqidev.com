---
import { type Lang, t, url } from "../i18n";
import { beian, site, social } from "../site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<footer class="site-footer">
  <div class="links">
    <span>© 2026 {site[lang].author}</span>
    <a href={url(lang, "/index.xml")}>RSS</a>
    <a href={url(lang, "/llms.txt")}>llms.txt</a>
    <a href="/sitemap.xml">Sitemap</a>
    <a href={social.github}>GitHub</a>
    <a href={url(lang, "/privacy/")}>{t[lang].privacy}</a>
    <span>{t[lang].builtWith}</span>
  </div>
  <div class="beian">
    <a href={`https://beian.mps.gov.cn/#/query/webSearch?code=${beian.gonganCode}`} target="_blank" rel="noreferrer">
      <img src="/images/beian-icon.png" alt="" width="14" height="14" />
      <span>{beian.gongan}</span>
    </a>
    <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{beian.icp}</a>
  </div>
</footer>
