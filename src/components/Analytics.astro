---
import { analytics } from "../site";
---

<script is:inline define:vars={{ a: analytics }}>
  // Only the published site reports traffic; local builds and previews stay out of the stats.
  if (/(^|\.)zhuoqidev\.com$/.test(location.hostname)) {
    var add = function (src, attrs) {
      var s = document.createElement("script");
      s.async = true;
      s.src = src;
      for (var k in attrs || {}) s.setAttribute(k, attrs[k]);
      document.head.appendChild(s);
    };
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () {
      dataLayer.push(arguments);
    };
    gtag("js", new Date());
    gtag("config", a.google);
    // The trackers (about 200 KB) wait until the page has loaded and drawn its first content, so
    // they never compete with it. Lab tools (Lighthouse / PageSpeed) sometimes record the first
    // paint well after load; trackers started at load then land on the simulated LCP path and
    // drag the mobile score down. Browsers without paint timing start them 5 s after load.
    var started = false;
    var start = function () {
      if (started) return;
      started = true;
      add("https://www.googletagmanager.com/gtag/js?id=" + a.google);
      add("https://hm.baidu.com/hm.js?" + a.baidu);
      add("https://static.cloudflareinsights.com/beacon.min.js", {
        "data-cf-beacon": JSON.stringify({ token: a.cloudflare }),
      });
    };
    var afterPaint = function () {
      setTimeout(start, 5000);
      if (performance.getEntriesByName("first-contentful-paint").length) return start();
      try {
        new PerformanceObserver(function (list) {
          if (list.getEntriesByName("first-contentful-paint").length) start();
        }).observe({ type: "paint", buffered: true });
      } catch (e) {}
    };
    if (document.readyState === "complete") afterPaint();
    else addEventListener("load", afterPaint, { once: true });
  }
</script>
