---
import { analytics, api } from "../site";
---

<script is:inline define:vars={{ a: analytics, api }}>
  // Only the published site reports traffic; local builds and previews stay out of the stats, and so
  // do pages opened in a window on the desk (the desk itself already counted the visit).
  if (/(^|\.)zhuoqidev\.com$/.test(location.hostname) && !document.documentElement.classList.contains("embedded")) {
    var add = function (src, attrs) {
      var s = document.createElement("script");
      s.async = true;
      s.src = src;
      for (var k in attrs || {}) s.setAttribute(k, attrs[k]);
      document.head.appendChild(s);
    };
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () {
      dataLayer.push(arguments);
    };
    gtag("js", new Date());
    gtag("config", a.google);
    // The owner's opt-out: opening any page with ?nocount=1 stops this browser from adding to the
    // site's own counts (zq-nocount in localStorage), ?nocount=0 starts it again. Not shown to readers.
    var noCount = false;
    try {
      var flag = new URLSearchParams(location.search).get("nocount");
      if (flag === "1") localStorage.setItem("zq-nocount", "1");
      else if (flag === "0") localStorage.removeItem("zq-nocount");
      noCount = localStorage.getItem("zq-nocount") === "1";
    } catch (e) {}
    // The trackers (about 200 KB) wait until the page has loaded and drawn its first content, so
    // they never compete with it. Lab tools (Lighthouse / PageSpeed) sometimes record the first
    // paint well after load; trackers started at load then land on the simulated LCP path and
    // drag the mobile score down. Browsers without paint timing start them 5 s after load.
    var started = false;
    var start = function () {
      if (started) return;
      started = true;
      // The site's own count: one empty request, no cookie. It records where the visitor is, not
      // who; crawlers never run this, so they are counted from the server side. Pages from the
      // overseas line carry `Server-Timing: line;desc=cf` (functions/_middleware.ts) and POST to
      // functions/api/hit.ts. Pages from the mainland line (Aliyun CDN) fetch /hit.gif from the
      // same CDN instead, whose logs scripts/stats-cn.ts reads each day: a beacon from there to
      // Cloudflare is often lost on its way across the border. Browsers that cannot tell which line
      // they are on send the beacon.
      // The beacon carries the page's path (`?p=`) so articles are counted one by one; /hit.gif
      // needs none, because the CDN log records the page as the request's Referer.
      try {
        var nav = performance.getEntriesByType("navigation")[0];
        var timing = nav && nav.serverTiming;
        var cf = timing && timing.some(function (t) {
          return t.name === "line" && t.description === "cf";
        });
        if (noCount) {
          // the owner's own browser: no count, trackers as usual
        } else if (timing && !cf) fetch("/hit.gif", { cache: "no-store", keepalive: true }).catch(function () {});
        else navigator.sendBeacon(api + "/api/hit?p=" + encodeURIComponent(location.pathname));
      } catch (e) {}
      add("https://www.googletagmanager.com/gtag/js?id=" + a.google);
      add("https://hm.baidu.com/hm.js?" + a.baidu);
      add("https://static.cloudflareinsights.com/beacon.min.js", {
        "data-cf-beacon": JSON.stringify({ token: a.cloudflare }),
      });
    };
    var afterPaint = function () {
      setTimeout(start, 5000);
      if (performance.getEntriesByName("first-contentful-paint").length) return start();
      try {
        new PerformanceObserver(function (list) {
          if (list.getEntriesByName("first-contentful-paint").length) start();
        }).observe({ type: "paint", buffered: true });
      } catch (e) {}
    };
    if (document.readyState === "complete") afterPaint();
    else addEventListener("load", afterPaint, { once: true });
  }
</script>
