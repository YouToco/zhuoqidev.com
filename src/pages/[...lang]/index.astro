---
import { getProjects, getPosts, postUrl, shortTitle, slugOf, splitTitle, terms, ymd } from "../../lib/content";
import { board, layout } from "../../data/board";
import { type Lang, langParams, t, url } from "../../i18n";
import Polaroid from "../../components/Polaroid.astro";
import Base from "../../layouts/Base.astro";
import { SITE_URL, site, social } from "../../site";

export const getStaticPaths = langParams;
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = t[lang];
const B = board[lang];
const posts = await getPosts(lang);
const projects = await getProjects(lang);
const bySlug = new Map(posts.map((p) => [slugOf(p), p]));
const latest = posts[0]!;
const series = terms(posts, "series").slice(0, 2);
const notes = B.notes.map((n) => ({ ...n, post: bySlug.get(n.slug)! }));
const stickyPost = bySlug.get(B.sticky.slug)!;
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
const md = (d: Date) => ymd(d).slice(5);
// Desk icons: each opens its page in a window on the desk (src/scripts/windows.ts).
const icons = [
  { name: "posts/", href: url(lang, "/posts/"), kind: "folder" },
  { name: "projects/", href: url(lang, "/projects/"), kind: "folder" },
  { name: "about.md", href: url(lang, "/about/"), kind: "md" },
  { name: "latest.md", href: postUrl(lang, slugOf(latest)), kind: "md" },
  { name: "llms.txt", href: url(lang, "/llms.txt"), kind: "txt" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site[lang].title,
  url: new URL(url(lang, "/"), SITE_URL).href,
  inLanguage: lang === "zh" ? "zh-CN" : "en",
  description: site[lang].description,
  author: { "@type": "Person", name: site[lang].author, jobTitle: site[lang].headline, sameAs: [social.github, social.x] },
};
---

<Base lang={lang} path="/" section="home" jsonLd={jsonLd}>
  <Fragment slot="head">
    <script is:inline>
      // First visit on a wide screen: hold the desk behind a short boot screen (src/scripts/boot.ts).
      // The timer is a safety net in case that script never runs.
      try {
        if (window.self === window.top && !localStorage.getItem("zq-booted") && matchMedia("(min-width: 1001px) and (prefers-reduced-motion: no-preference)").matches) {
          const root = document.documentElement;
          root.classList.add("booting");
          root.dataset.bootFailsafe = String(setTimeout(() => root.classList.remove("booting"), 7000));
        }
      } catch {}
    </script>
  </Fragment>
  <div class="boot" data-boot aria-hidden="true" slot="before">
    <div class="laptop">
      <div class="terminal">
        <div class="bar"><i></i><i></i><i></i><span>{B.terminal.title}</span></div>
        <div class="tty">
          <p class="ln cmd"><span class="p">$</span> whoami</p>
          <p class="ln o">&gt; {B.terminal.whoami}</p>
          <p class="ln cmd gap"><span class="p">$</span> ls ~/desk</p>
          <p class="ln o">&gt; {L.bootLs(posts.length, projects.length)}</p>
          <p class="ln cmd gap"><span class="p">$</span> open zhuoqidev.com</p>
          <p class="ln o">&gt; <span class="boot-bar"><i></i></span></p>
        </div>
      </div>
    </div>
    <p class="boot-skip">{L.bootSkip}</p>
  </div>
  <div class="home">
    <aside class="index" aria-labelledby="idx-h">
      <h2 id="idx-h">✦ {L.allPosts} <small>{L.postsCount(posts.length)}</small></h2>
      {
        years.map((y) => (
          <>
            <div class="year">{y}</div>
            <ol>
              {posts
                .filter((p) => p.data.date.getUTCFullYear() === y)
                .map((p) => (
                  <li>
                    <a class:list={{ on: p === latest }} href={postUrl(lang, slugOf(p))} data-vt>
                      <span class="dot" />
                      <span class="d">{md(p.data.date)}</span>
                      <span>{shortTitle(p)}</span>
                    </a>
                  </li>
                ))}
            </ol>
          </>
        ))
      }
      <div class="agent-links">
        {L.forAgentsIndex}<br /><a href={url(lang, "/llms.txt")}>/llms.txt</a> ·
        <a href={url(lang, "/llms-full.txt")}>/llms-full.txt</a> ·
        <a href={`${postUrl(lang, slugOf(latest))}index.md`}>{L.eachPostMd}</a>
      </div>
    </aside>

    <main class="board-wrap dotgrid" id="main">
      <div class="board-tools">
        <span class="hint">{L.boardHint}</span>
        <time class="clock" data-clock hidden></time>
        <button class="chip-btn" id="reset-board" type="button">{L.boardReset}</button>
      </div>
      <div class="board" id="board">
        <section class="pin hero" id="hero" style={layout.hero}>
          <h1>{B.hero.before}<span class="mark">{B.hero.mark}</span></h1>
          <p>{B.hero.tagline}</p>
          <div class="sub">{B.hero.sub}</div>
        </section>

        <Polaroid lang={lang} width={130} class="pin" id="portrait" style={layout.portrait} drag />

        <svg class="pin doodle" style={layout.doodle} width="150" height="86" viewBox="0 0 150 86" aria-hidden="true">
          <text x="2" y="20">{B.doodle}</text>
          <path d="M20 32 C 50 44, 92 46, 128 74" fill="none" stroke="#d9452b" stroke-width="2.2" stroke-linecap="round"></path>
          <path d="M114 76 L129 75 L124 61" fill="none" stroke="#d9452b" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>

        <figure class="pin sticky" id="sticky" data-drag style={layout.sticky}>
          <blockquote><q>{B.sticky.quote}</q></blockquote>
          <figcaption>{B.sticky.from} <a href={postUrl(lang, B.sticky.slug)}>{shortTitle(stickyPost)}</a></figcaption>
        </figure>

        <div class="pin terminal" id="term" data-drag style={layout.term}>
          <div class="bar"><i></i><i></i><i></i><span>{B.terminal.title}</span></div>
          <pre><span class="p">$</span> whoami
<span class="o">{B.terminal.whoami}</span>

<span class="p">$</span> ls posts/ | wc -l
<span class="o">{posts.length}  # {B.terminal.countNote}</span>

<span class="p">$</span> cat focus.md
<span class="o">{B.terminal.focus.join("\n")}</span>

<span class="p">$</span> open <a class="y" href={postUrl(lang, slugOf(latest))}>latest.md</a> <span class="cursor"></span></pre>
        </div>

        <article class="pin card feature" id="feature" data-drag style={layout.feature}>
          <span class="tape"></span>
          <div class="row">
            <span class="tag red">{L.latest}</span>
            {latest.data.series && <span class="tag">{latest.data.series} #{String(latest.data.seriesOrder ?? 1).padStart(2, "0")}</span>}
          </div>
          <h2><a href={postUrl(lang, slugOf(latest))} data-vt>{splitTitle(latest.data.title).main}</a></h2>
          <p>{latest.data.description}</p>
          <div class="foot">
            <time datetime={ymd(latest.data.date)}>{ymd(latest.data.date)}</time>
            <a class="go" href={postUrl(lang, slugOf(latest))}>{L.readMore}</a>
          </div>
        </article>

        {
          series.map((s, i) => (
            <section class="pin card folder" id={`series-${i}`} data-drag style={layout[`series-${i}`]}>
              <span class="tab">series/</span>
              <div class="in">
                <h3>
                  <a href={url(lang, `/series/${s.slug}/`)}>{s.name}</a> <small>{L.postsCount(s.posts.length)}</small>
                </h3>
                <ol>
                  {s.posts.map((p, n) => (
                    <li>
                      <a href={postUrl(lang, slugOf(p))} data-vt>
                        <span class="n">{String(n + 1).padStart(2, "0")}</span>
                        {shortTitle(p)}
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            </section>
          ))
        }

        <div class="pin sticker" id="robot" data-drag style={layout.robot} aria-hidden="true">🤖</div>

        {
          notes.map((n, i) => (
            <article class="pin card memo" id={`note-${i}`} data-drag style={layout[`note-${i}`]}>
              {i === 1 && <span class="tape blue" />}
              <span class="big-n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <span class="kicker">
                {n.label} · {md(n.post.data.date)}
              </span>
              <h3>
                <a href={postUrl(lang, n.slug)} data-vt>{shortTitle(n.post)}</a>
              </h3>
              <p>{n.blurb}</p>
            </article>
          ))
        }

        <section class="pin card projects" id="projects" data-drag style={layout.projects}>
          <h3 class="kicker"><a href={url(lang, "/projects/")}>{B.projectsLabel}</a></h3>
          {
            projects.map((p) => (
              <a href={url(lang, `/projects/${slugOf(p)}/`)}>
                <b data-vt>{splitTitle(p.data.title).main}</b>
                <span>{p.data.description}</span>
              </a>
            ))
          }
        </section>

        <section class="pin card stamps" id="stamps" data-drag style={layout.stamps} aria-label={B.stampsLabel}>
          <span class="stamp-round">CKA</span><span class="stamp-round">CKS</span><span class="stamp-round">RHCE</span>
        </section>

        <div class="pin sticker" id="coffee" data-drag style={layout.coffee} aria-hidden="true">☕</div>

        <div class="pin desk-icons" id="icons" style={layout.icons}>
        <ul aria-label={L.deskIcons}>
          {
            icons.map((i) => (
              <li>
                <a class="desk-icon" href={i.href} data-kind={i.kind}>
                  <span class="glyph" aria-hidden="true">
                    {i.kind === "folder" ? (
                      <svg width="58" height="46" viewBox="0 0 58 46">
                        <path class="back" d="M1 6a3 3 0 0 1 3-3h15l5 5h30a3 3 0 0 1 3 3v29a3 3 0 0 1-3 3H4a3 3 0 0 1-3-3z" />
                        <path class="front" d="M1 14h56v26a3 3 0 0 1-3 3H4a3 3 0 0 1-3-3z" />
                      </svg>
                    ) : (
                      <>
                        <svg width="44" height="54" viewBox="0 0 44 54">
                          <path class="page" d="M4 1h26l13 13v36a3 3 0 0 1-3 3H4a3 3 0 0 1-3-3V4a3 3 0 0 1 3-3z" />
                          <path class="fold" d="M30 1v10a3 3 0 0 0 3 3h10" />
                          <path class="lines" d="M9 22h20M9 28h25M9 34h16" />
                        </svg>
                        <span class:list={["badge", i.kind]}>{i.kind}</span>
                      </>
                    )}
                  </span>
                  <span class="name">{i.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="icons-hint" aria-hidden="true">{L.iconsHint}</p>
        </div>
      </div>
    </main>
  </div>
</Base>

<script>
  import "../../scripts/boot";
  import "../../scripts/board";
  import "../../scripts/windows";
</script>
