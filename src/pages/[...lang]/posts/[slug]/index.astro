---
import { getCollection, render } from "astro:content";
import { type Lang, LANGS, other, t, url } from "../../../../i18n";
import Base from "../../../../layouts/Base.astro";
import { numberedByAuthor } from "../../../../lib/markdown/numbering";
import {
  getPosts,
  inlineMd,
  postUrl,
  type Post,
  readingStats,
  slugOf,
  splitTitle,
  termSlug,
  ymd,
  zoomSources,
} from "../../../../lib/content";
import { SITE_URL, site, social } from "../../../../site";

export async function getStaticPaths() {
  const out = [];
  for (const lang of LANGS) {
    const posts = await getPosts(lang);
    for (const post of posts) {
      out.push({ params: { lang: lang === "zh" ? undefined : "en", slug: slugOf(post) }, props: { lang, post, posts } });
    }
  }
  return out;
}

interface Props {
  lang: Lang;
  post: Post;
  posts: Post[];
}
const { lang, post, posts } = Astro.props;
const L = t[lang];
const slug = slugOf(post);
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 && h.slug !== "footnote-label");
const ownNumbers = numberedByAuthor(toc.map((h) => h.text));
const { main, sub } = splitTitle(post.data.title);
const stats = readingStats(post.body ?? "", lang);
const mdBytes = new TextEncoder().encode(post.body ?? "").length;

const series = post.data.series
  ? posts
      .filter((p) => p.data.series === post.data.series)
      .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];
const pos = series.findIndex((p) => p.id === post.id);
const prev = pos > 0 ? series[pos - 1] : undefined;
const next = pos >= 0 && pos < series.length - 1 ? series[pos + 1] : undefined;
// Outside a series, fall back to the neighbouring posts by date.
const idx = posts.findIndex((p) => p.id === post.id);
const older = prev ?? (series.length ? undefined : posts[idx + 1]);
const newer = next ?? (series.length ? undefined : posts[idx - 1]);

const zoom = await zoomSources(post, Astro.site!);
const canonical = new URL(postUrl(lang, slug), SITE_URL).href;
// Social card rendered from src/pages/og-cards/ by scripts/og-images.mjs.
const ogImage = new URL("og.png", canonical).href;
const alt = (await getCollection("posts")).some((p) => p.id === `${slug}/${other(lang)}`);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  inLanguage: lang === "zh" ? "zh-CN" : "en",
  datePublished: ymd(post.data.date),
  dateModified: ymd(post.data.updated ?? post.data.date),
  "@id": canonical,
  mainEntityOfPage: canonical,
  url: canonical,
  image: ogImage,
  keywords: post.data.tags.join(", "),
  author: { "@type": "Person", name: site[lang].author, url: new URL(url(lang, "/about/"), SITE_URL).href, sameAs: [social.github, social.x] },
  publisher: { "@type": "Person", name: site[lang].author },
  ...(alt && {
    [lang === "zh" ? "workTranslation" : "translationOfWork"]: {
      "@id": new URL(postUrl(other(lang), slug), SITE_URL).href,
    },
  }),
};
---

<Base
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  path={`/posts/${slug}/`}
  altPath={alt ? `/posts/${slug}/` : null}
  section="posts"
  ogType="article"
  ogImage={ogImage}
  jsonLd={jsonLd}
  markdown="index.md"
  bodyClass="dotgrid"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.date.toISOString()} />
    {post.data.updated && <meta property="article:modified_time" content={post.data.updated.toISOString()} />}
    {post.data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </Fragment>
  <div class="progress" aria-hidden="true" slot="before"></div>
  <a class="chip-btn hide-sm" href={url(lang, "/")} slot="topbar">{L.backHome}</a>

  <div class="read-progress" aria-hidden="true"></div>
  <main class="post-layout">
    <nav class="toc card" aria-label={L.toc}>
      <span class="kicker">{L.toc}</span>
      <ol>
        {
          toc.map((h, i) => (
            <li>
              <a href={`#${h.slug}`}>
                {!ownNumbers && <span class="n">{String(i + 1).padStart(2, "0")}</span>}
                <span>{h.text}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <article class="paper card" id="main" data-pagefind-body>
      <div class="crumb" data-pagefind-ignore>~/posts/<b>{slug}</b>.md</div>
      <div class="meta-row">
        {
          post.data.series && (
            <a class="tag" href={url(lang, `/series/${termSlug(post.data.series)}/`)}>
              {L.seriesPart(post.data.series, post.data.seriesOrder ?? pos + 1)}
            </a>
          )
        }
        {post.data.categories.map((c) => <a class="tag red" href={url(lang, `/categories/${termSlug(c)}/`)}>{c}</a>)}
        <span class="m"><time datetime={ymd(post.data.date)} data-pagefind-meta="date">{ymd(post.data.date)}</time></span>
        {
          post.data.updated && ymd(post.data.updated) !== ymd(post.data.date) && (
            <span class="m">
              {L.updated} <time datetime={ymd(post.data.updated)}>{ymd(post.data.updated)}</time>
            </span>
          )
        }
        <span class="m">{L.length(stats.count, stats.minutes)}</span>
      </div>
      <h1 class="post-title" data-vt>
        {main}
        {
          sub && (
            <>
              <span class="sr-only"> — </span>
              <span class="post-sub">{sub}</span>
            </>
          )
        }
      </h1>
      {
        post.data.lead && (
          <div class="margin-note" aria-hidden="true">
            {L.marginNote[0]}
            <br />
            {L.marginNote[1]}
            <svg width="70" height="40" viewBox="0 0 70 40">
              <path d="M60 4 C 40 10, 22 18, 8 34" fill="none" stroke="#d9452b" stroke-width="2" stroke-linecap="round" />
              <path d="M6 22 L8 35 L20 31" fill="none" stroke="#d9452b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
        )
      }
      {
        post.data.lead && (
          <div class="tldr">
            <span class="tape" />
            <span class="k">{L.tldr}</span>
            <p set:html={inlineMd(post.data.lead)} />
          </div>
        )
      }
      {
        toc.length > 2 && (
          <details class="toc-inline" data-pagefind-ignore>
            <summary>{L.toc}</summary>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <footer class="post-end">
        <div class="tags-row">
          {post.data.tags.map((tag) => <a class="tag" href={url(lang, `/tags/${termSlug(tag)}/`)}>#{tag}</a>)}
        </div>
        <div class="agent-box" data-pagefind-ignore>
          <span><b>$</b> {L.forAgents}<a href="index.md" type="text/markdown">index.md</a>（{L.mdNote(Math.max(1, Math.round(mdBytes / 1024)))}）</span>
          <button class="chip-btn" type="button" data-copy-md="index.md" hidden>{L.copyMd}</button>
        </div>
        {
          (older || newer) && (
            <nav class="series-nav" data-pagefind-ignore aria-label={post.data.series ?? L.posts}>
              {older ? (
                <a class="card" href={postUrl(lang, slugOf(older))} rel="prev">
                  <span class="kicker">{L.prev}</span>
                  <b data-vt>{splitTitle(older.data.title).main}</b>
                </a>
              ) : <span />}
              {newer && (
                <a class="card next" href={postUrl(lang, slugOf(newer))} rel="next">
                  <span class="kicker">{L.next}</span>
                  <b data-vt>{splitTitle(newer.data.title).main}</b>
                </a>
              )}
            </nav>
          )
        }
        {
          series.length > 0 && (
            <p class="series-all" data-pagefind-ignore>
              <a href={url(lang, `/series/${termSlug(post.data.series!)}/`)}>{L.seriesAll(post.data.series!, series.length)}</a>
            </p>
          )
        }
      </footer>
    </article>

    <aside class="rail" aria-label="links">
      <a class="chip-btn" href="#main">{L.backTop}</a>
      {alt && <a class="chip-btn" href={postUrl(other(lang), slug)} hreflang={other(lang)}>{L.readOther}</a>}
      <a class="chip-btn" href="index.md" type="text/markdown">index.md</a>
      <div class="width-pick" role="group" aria-labelledby="width-pick-label" hidden>
        <span class="kicker" id="width-pick-label">{L.readWidth}</span>
        <div class="seg">
          {
            (["narrow", "default", "wide", "full"] as const).map((w) => (
              <button type="button" data-width-set={w} aria-pressed={w === "default" ? "true" : "false"}>
                {L.widths[w]}
              </button>
            ))
          }
        </div>
      </div>
    </aside>
  </main>
</Base>

{
  Object.keys(zoom).length > 0 && (
    <>
      <script type="application/json" id="zoom-map" set:html={JSON.stringify(zoom)} />
      <dialog class="zoom" aria-label={L.zoomOpen}>
        <div class="zoom-bar">
          <span class="zoom-hint">{L.zoomHint}</span>
          <button class="chip-btn" type="button" data-zoom="out" aria-label={L.zoomOut}>−</button>
          <button class="chip-btn zoom-level" type="button" data-zoom="fit" data-fit={L.zoomFit}>{L.zoomFit}</button>
          <button class="chip-btn" type="button" data-zoom="in" aria-label={L.zoomIn}>+</button>
          <form method="dialog"><button class="chip-btn" type="submit" autofocus>{L.zoomClose} ✕</button></form>
        </div>
        <div class="zoom-stage"><img alt="" decoding="async" draggable="false" /></div>
      </dialog>
    </>
  )
}

<script>
  import "../../../../scripts/post";
</script>
