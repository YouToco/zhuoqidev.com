---
import { getEntry, render } from "astro:content";
import Page from "../../../components/Page.astro";
import { type Lang, langParams } from "../../../i18n";
import Base from "../../../layouts/Base.astro";

export const getStaticPaths = langParams;
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = (await getEntry("pages", `privacy/${lang}`))!;
const { Content } = await render(page);
---

<Base lang={lang} title={page.data.title} description={page.data.description} path="/privacy/" bodyClass="dotgrid">
  <Page lang={lang} title={page.data.title} crumb="~/privacy.md" date={page.data.date}>
    <Content />
  </Page>
</Base>
