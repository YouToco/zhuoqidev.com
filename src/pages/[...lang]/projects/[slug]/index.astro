---
import { getCollection, render } from "astro:content";
import ArgusStory from "../../../../components/ArgusStory.astro";
import Page from "../../../../components/Page.astro";
import ZoomDialog from "../../../../components/ZoomDialog.astro";
import { type Lang, LANGS } from "../../../../i18n";
import Base from "../../../../layouts/Base.astro";
import { getProjects, type Project, slugOf, zoomSources } from "../../../../lib/content";

export async function getStaticPaths() {
  const out = [];
  for (const lang of LANGS) {
    for (const project of await getProjects(lang)) {
      out.push({ params: { lang: lang === "zh" ? undefined : "en", slug: slugOf(project) }, props: { lang, project } });
    }
  }
  return out;
}
interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project } = Astro.props;
const slug = slugOf(project);
const { Content } = await render(project);
const all = await getCollection("projects");
const hasAlt = all.some((p) => slugOf(p) === slug && p.id !== project.id);
const zoom = await zoomSources(project, Astro.site!);
---

<Base
  lang={lang}
  title={project.data.title}
  seoTitle={project.data.seoTitle}
  description={project.data.description}
  path={`/projects/${slug}/`}
  altPath={hasAlt ? `/projects/${slug}/` : null}
  section="projects"
  ogType="article"
  bodyClass="dotgrid"
>
  <Page
    lang={lang}
    title={project.data.title}
    crumb={`~/projects/${slug}.md`}
    date={project.data.date}
    glyph={project.data.glyph}
    searchable
  >
    {project.data.scene === "argus" && <ArgusStory slot="hero" lang={lang} />}
    <Content />
  </Page>
</Base>

<ZoomDialog lang={lang} zoom={zoom} />

<script>
  // Copy buttons on code blocks and the image viewer, as on article pages.
  import "../../../../scripts/post";
</script>
