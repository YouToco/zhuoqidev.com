---
import { fontData } from "astro:assets";
import Analytics from "../components/Analytics.astro";
import Dock from "../components/Dock.astro";
import Fonts from "../components/Fonts.astro";
import Footer from "../components/Footer.astro";
import Topbar from "../components/Topbar.astro";
import WechatDialog from "../components/WechatDialog.astro";
import { htmlLang, type Lang, ogLocale, other, url } from "../i18n";
import { site, social } from "../site";
import "../styles/global.css";

export interface Props {
  lang: Lang;
  /** Page title without the site name. Omit on the home page. */
  title?: string | undefined;
  description?: string | undefined;
  /** Path of this page without the language prefix, e.g. "/posts/foo/". */
  path: string;
  /** Path of the translated page; null when this page has no translation. */
  altPath?: string | null | undefined;
  section?: "home" | "posts" | "about" | "projects" | undefined;
  ogType?: "website" | "article" | undefined;
  ogImage?: string | undefined;
  jsonLd?: Record<string, unknown> | undefined;
  /** Markdown twin of this page, linked as rel=alternate type=text/markdown. */
  markdown?: string | undefined;
  bodyClass?: string | undefined;
  noindex?: boolean | undefined;
}

const { lang, title, path, section, ogType = "website", jsonLd, markdown, bodyClass, noindex } = Astro.props;
const altPath = Astro.props.altPath === undefined ? path : Astro.props.altPath;
const s = site[lang];
const description = Astro.props.description ?? s.description;
const fullTitle = title ? `${title} · ${s.title}` : s.title;
const canonical = new URL(url(lang, path), Astro.site).href;
const alt = altPath === null ? null : new URL(url(other(lang), altPath), Astro.site).href;
const zhHref = lang === "zh" ? canonical : alt;
const enHref = lang === "en" ? canonical : alt;
// Preload only the Latin body face; everything else loads on demand by unicode-range.
const bodyFont = (fontData["--font-inter"] ?? [])
  .filter((f) => f.weight === "400" && f.style === "normal")
  .flatMap((f) => f.src.filter((s) => s.format === "woff2").map((s) => s.url))
  .slice(0, 1);
const ogImage = Astro.props.ogImage ?? new URL("/og-default.png", Astro.site).href;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a stored day/night choice before first paint; without one the CSS follows the system.
      try {
        const theme = JSON.parse(localStorage.getItem("zq-theme"));
        if (theme === "dark" || theme === "light") document.documentElement.dataset.theme = theme;
      } catch {}
      // The reader's article width (the picker beside each post), also before first paint.
      try {
        const width = JSON.parse(localStorage.getItem("zq-width"));
        if (width === "narrow" || width === "wide" || width === "full") document.documentElement.dataset.width = width;
      } catch {}
      // Opened in a window on this site's own desk: show just the page, without the site's frame.
      try {
        if (window.self !== window.top && window.top.location.origin === location.origin) document.documentElement.classList.add("embedded");
      } catch {}
    </script>
    <script is:inline>
      // Page-to-page transitions (CSS @view-transition in global.css). The title you click glides
      // into the next page's headline, and a post's headline glides back into its card. Titles are
      // marked data-vt; exactly one per page gets the shared name, or the browser skips the effect.
      // Lives in <head> because pagereveal fires before deferred scripts run.
      (function () {
        if (!("onpagereveal" in window)) return;
        var NAME = "vt-title";
        var path = function (u) {
          try {
            var x = new URL(u, location.href);
            return x.origin === location.origin ? x.pathname : null;
          } catch (e) {
            return null;
          }
        };
        var target = function (el) {
          var a = el.closest("a") || el.querySelector("a");
          return a && path(a.href);
        };
        var mark = function (el, vt) {
          el.style.viewTransitionName = NAME;
          vt.finished.finally(function () {
            el.style.viewTransitionName = "";
          });
        };
        var heading = function () {
          return document.querySelector("h1[data-vt]");
        };
        var clicked = null;
        addEventListener("click", function (e) {
          var a = e.target.closest && e.target.closest("a");
          clicked = a && (a.matches("[data-vt]") ? a : a.querySelector("[data-vt]"));
        }, true);
        addEventListener("pageswap", function (e) {
          if (!e.viewTransition || !e.activation) return;
          var to = path(e.activation.entry.url);
          var el = clicked && target(clicked) === to ? clicked : heading();
          if (el) mark(el, e.viewTransition);
        });
        addEventListener("pagereveal", function (e) {
          if (!e.viewTransition) return;
          var el = heading();
          if (!el) {
            var nav = window.navigation && navigation.activation && navigation.activation.from;
            var from = path(nav ? nav.url : document.referrer);
            // The largest visible title linking to the page we came from.
            var best = 0;
            document.querySelectorAll("[data-vt]").forEach(function (c) {
              if (!from || target(c) !== from) return;
              var r = c.getBoundingClientRect();
              var area = r.bottom > 0 && r.top < innerHeight ? r.width * r.height : 0;
              if (area > best) {
                best = area;
                el = c;
              }
            });
          }
          if (el) mark(el, e.viewTransition);
        });
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={s.author} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {zhHref && <link rel="alternate" hreflang="zh-CN" href={zhHref} />}
    {enHref && <link rel="alternate" hreflang="en" href={enHref} />}
    {zhHref && enHref && <link rel="alternate" hreflang="x-default" href={zhHref} />}
    <link rel="alternate" type="application/rss+xml" title={s.title} href={url(lang, "/index.xml")} />
    {markdown && <link rel="alternate" type="text/markdown" title="Markdown" href={markdown} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fbf8f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14161b" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content={s.title} />
    <meta property="og:title" content={title ?? s.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alt && <meta property="og:locale:alternate" content={ogLocale[other(lang)]} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={social.xHandle} />

    <Fonts />
    {bodyFont.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">{lang === "zh" ? "跳到正文" : "Skip to content"}</a>
    <slot name="before" />
    <Topbar lang={lang} path={path} altPath={altPath}><slot name="topbar" /></Topbar>
    <slot />
    <Footer lang={lang} path={path} />
    <Dock lang={lang} section={section} />
    <WechatDialog lang={lang} />
    <Analytics />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
