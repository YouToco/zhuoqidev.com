{
  "name": "zhuoqidev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/subset-fonts.mjs && node scripts/og-images.mjs && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check && tsc -p functions",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify-dist.mjs",
    "diagrams": "test -d tools/diagrams/node_modules || pnpm --dir tools/diagrams install --frozen-lockfile; node tools/diagrams/generate.mjs",
    "poster": "test -d tools/models/node_modules || pnpm --dir tools/models install --frozen-lockfile; node tools/models/argus-poster.mjs",
    "geo": "test -d tools/geo/node_modules || pnpm --dir tools/geo install --frozen-lockfile; node tools/geo/build.mjs",
    "test": "node --test \"server/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "dev:functions": "wrangler d1 migrations apply DB --local && wrangler pages dev dist --port 8788"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "astro": "7.3.6",
    "hast-util-to-text": "4.0.2",
    "playwright": "1.63.0",
    "rehype-mermaid": "3.0.0",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20261007.1",
    "@eslint/js": "10.0.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.1",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vfile": "6.0.3",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
