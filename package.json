{
  "name": "zhuoqidev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/subset-fonts.mjs && node scripts/og-images.mjs && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check && tsc -p functions",
    "verify": "node scripts/verify-dist.mjs",
    "diagrams": "test -d tools/diagrams/node_modules || npm --prefix tools/diagrams ci --no-audit --no-fund; node tools/diagrams/generate.mjs",
    "test": "node --test \"server/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "dev:functions": "wrangler d1 migrations apply DB --local && wrangler pages dev dist --port 8788"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "astro": "7.3.6",
    "hast-util-to-text": "4.0.2",
    "playwright": "1.63.0",
    "rehype-mermaid": "3.0.0",
    "sharp": "0.35.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20261007.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.1",
    "pagefind": "1.5.2",
    "subset-font": "2.9.0",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild": false
  }
}
