# Cloudflare Pages response headers. The deploy step sets the same text types on Aliyun OSS.
# Plain-text twins for agents: declare the charset so Chinese text never renders as mojibake.
/*.md
  Content-Type: text/markdown; charset=utf-8

/*.txt
  Content-Type: text/plain; charset=utf-8

# Build output under /_astro/ and the per-page font subsets under /_fonts/
# (scripts/subset-fonts.mjs) are content-hashed, so they can be cached forever.
# The deploy step sets the same header on Aliyun OSS.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/_fonts/*
  Cache-Control: public, max-age=31536000, immutable
