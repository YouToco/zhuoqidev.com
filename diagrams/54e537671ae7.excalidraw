      "seed": 1793317986,
      "version": 3,
      "versionNonce": 1982766498,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791515562004,
      "link": null,
      "locked": false,
      "text": "Mostly Chinese models\n→ Alibaba / Tencent Cloud mainland: long-running gateway (Higress or your own) + Redis\navoid Function Compute / SCF; edge functions only in front",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "CN1",
      "originalText": "Mostly Chinese models\n→ Alibaba / Tencent Cloud mainland: long-running gateway (Higress or your own) + Redis\navoid Function Compute / SCF; edge functions only in front",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Y4sc_PovOiDiCmvK0Ce1r",
      "type": "text",
      "x": 110.00381469726562,
      "y": 290,
      "width": 526.3048706054688,
      "height": 80,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 1152253986,
      "version": 3,
      "versionNonce": 1070400894,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791515562004,
      "link": null,
      "locked": false,
      "text": "Overseas models too\n→ mainland entry + offshore node for overseas models\nexit from a region OpenAI / Anthropic support (e.g. Singapore, Tokyo)\nswitch Alibaba Cloud offshore nodes to CDT by hand",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "CN2",
      "originalText": "Overseas models too\n→ mainland entry + offshore node for overseas models\nexit from a region OpenAI / Anthropic support (e.g. Singapore, Tokyo)\nswitch Alibaba Cloud offshore nodes to CDT by hand",
      "autoResize": true,
      "lineHeight": 1.25
    },
