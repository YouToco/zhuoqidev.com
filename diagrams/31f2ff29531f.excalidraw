      "isDeleted": false,
      "boundElements": null,
      "updated": 1791533601759,
      "link": null,
      "locked": false,
      "text": "想全部自己掌控\n→ 开源：BrightBean（不支持 X）、OpenPost（很新）",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "E",
      "originalText": "想全部自己掌控\n→ 开源：BrightBean（不支持 X）、OpenPost（很新）",
