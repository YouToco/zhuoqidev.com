    {
      "id": "pzPUx8jGTU8n6DLJ_4ne6",
      "type": "text",
      "x": 12.372688293457031,
      "y": 9.5,
      "width": 112.00021362304688,
      "height": 20,
      "angle": 0,
      "strokeColor": "#f08c00",
