    },
    {
      "id": "OND9P-tXb0Rm63y5-CK2n",
      "type": "text",
      "x": 70.0062255859375,
      "y": 84,
      "width": 395.440673828125,
      "height": 60,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 740665693,
      "version": 3,
      "versionNonce": 1726665907,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791533600568,
      "link": null,
      "locked": false,
      "text": "Reading and answering replies under your X posts\n→ Zernio; or SocialAPI.ai, Ayrshare (your own X key)\ntest the summoned rule on a real account first",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "A",
      "originalText": "Reading and answering replies under your X posts\n→ Zernio; or SocialAPI.ai, Ayrshare (your own X key)\ntest the summoned rule on a real account first",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "abbORdfTknAdWdlxL5AJp",
      "type": "text",
      "x": 70.00527954101562,
      "y": 210,
      "width": 377.52069091796875,
      "height": 60,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aG",
      "roundness": null,
      "seed": 1069708733,
      "version": 3,
      "versionNonce": 1902134269,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791533600568,
      "link": null,
      "locked": false,
      "text": "A web inbox, team workflow, an established vendor\n→ Vista Social (expensive), Eclincher\nAgorapulse's MCP only saves drafts",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "B",
      "originalText": "A web inbox, team workflow, an established vendor\n→ Vista Social (expensive), Eclincher\nAgorapulse's MCP only saves drafts",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SEqNLiLmpQDZlommjwvSM",
      "type": "text",
      "x": 70.0052490234375,
      "y": 334,
      "width": 464.848876953125,
      "height": 40,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aH",
      "roundness": null,
      "seed": 1925625373,
      "version": 3,
      "versionNonce": 112445011,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791533600568,
      "link": null,
      "locked": false,
      "text": "Many accounts, mostly IG, Threads, YouTube, LinkedIn Pages\nX only for posting → OmniSocials (per-workspace pricing)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "C",
      "originalText": "Many accounts, mostly IG, Threads, YouTube, LinkedIn Pages\nX only for posting → OmniSocials (per-workspace pricing)",
      "autoResize": true,
      "lineHeight": 1.25
    },
